# Praxic -- Environment Variables (for API key injection)
# Copy this file to .env and fill in your keys.
# env vars take precedence over config.toml.
# 密钥只保存在 .env；config.toml 一律不写 API Key。

# --- LLM API Keys ---
PRAXIC_LLM_API_KEY="sk-your-key-here"
# PRAXIC_LLM_BASE_URL="https://api.deepseek.com"
# PRAXIC_LLM_MODEL="deepseek-v4-pro"
# PRAXIC_LLM_PROVIDER="openai_compatible"

# Legacy compat (still works)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Anthropic Claude (set provider="anthropic" in config.toml)
ANTHROPIC_API_KEY=

# Tavily search (optional, web search disabled if empty)
TAVILY_API_KEY=
